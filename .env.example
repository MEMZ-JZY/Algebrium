# Algebrium local secrets and machine-specific configuration.
# Copy this file to ".env" in the repository root and fill in what you use.
# ".env" is git-ignored; never commit real keys.
# Variables already set in the shell take precedence over values from ".env".

# API key of the provider selected at startup. The variable name comes from
# "apiKeyEnv" of each profile in config.json:
DEEPSEEK_API_KEY=
# MIMO_API_KEY=
# KIMI_API_KEY=
# ARK_API_KEY=
# OPENROUTER_API_KEY=
# SILICONFLOW_API_KEY=

# Custom OpenAI-compatible provider (select "custom" in the startup menu):
# ALGEBRIUM_CUSTOM_BASE_URL=https://api.example.com/v1
# ALGEBRIUM_CUSTOM_MODEL=your-model-id
# ALGEBRIUM_CUSTOM_API_KEY=

# Optional overrides. The launch scripts already set working defaults for
# QDRANT_URL, ALGEBRIUM_KB_PATH and the CAS/search endpoints:
# ALGEBRIUM_PROVIDER=deepseek
# ALGEBRIUM_CAS_TIMEOUT_MS=45000
